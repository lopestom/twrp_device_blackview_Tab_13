#fstab file by lopestom for Alldocube X_Game_V1.0_20220112 - (T1023)-EN-R07 - p901a-t1023-64-128g8g-hdp-a1-bom1-r0
/system_root        ext4    /dev/block/mapper/system              flags=backup=1;wipeingui;logical;display="System_root"
/vendor             ext4    /dev/block/mapper/vendor             flags=backup=1;wipeingui;logical;display="Vendor"
/product            ext4    /dev/block/mapper/product             flags=backup=1;wipeingui;logical;display="Product"

# Images
/system_image	    emmc  	/dev/block/mapper/system           flags=backup=1;flashimg=1;logical;display="System_Image"
/vendor_image	    emmc  	/dev/block/mapper/vendor             flags=backup=1;flashimg=1;logical;display="Vendor_Image"
/product_image	    emmc	/dev/block/mapper/product             flags=backup=1;flashimg=1;logical;display="Product_Image"

# Core Partitions
/metadata             ext4    /dev/block/by-name/md_udc         flags=backup=1;display="metadata"
/data            ext4    /dev/block/by-name/userdata            flags=encryptable=footer;wipeingui;wipeduringfactoryreset

# Common partition
/cache           emmc    /dev/block/by-name/cache		 flags=display="cache";backup=0;wipeingui;wipeduringfactoryreset
/recovery            emmc    /dev/block/by-name/recovery               flags=backup=1;display="Recovery";flashimg=1
/boot            emmc    /dev/block/by-name/boot               flags=backup=1;display="Boot";flashimg=1
/dtbo            emmc    /dev/block/by-name/dtbo               flags=backup=1;display="Dtbo";flashimg=1
/persist         ext4    /dev/block/by-name/persist            flags=backup=1;display="Persist";mounttodecrypt
/persist_image   emmc    /dev/block/by-name/persist            flags=backup=1;display="Persist Image";flashimg=1
/vbmeta		    emmc	/dev/block/by-name/vbmeta           flags=display="vbmeta";backup=1;flashimg=1
/vbmeta_system   emmc    /dev/block/by-name/vbmeta_system      flags=backup=1;display="vbmeta_system";flashimg=1
/vbmeta_vendor   emmc    /dev/block/by-name/vbmeta_vendor      flags=backup=1;display="vbmeta_vendor";flashimg=1

# MediaTek partitions
/bootloader      emmc    /dev/block/by-name/lk                 flags=backup=1;display="Bootloader (lk)";flashimg=1
/bootloader2      emmc    /dev/block/by-name/lk2                 flags=backup=1;display="Bootloader2";flashimg=1
/logo		    emmc	/dev/block/by-name/logo             flags=display="logo";backup=1;flashimg=1
/expdb		    emmc	/dev/block/by-name/expdb             flags=display="expdb";backup=1
/seccfg		    emmc	/dev/block/by-name/seccfg           flags=display="SecCfg";backup=1
/para		    emmc	/dev/block/by-name/para             flags=display="para";backup=1;flashimg=1
/misc		    emmc	/dev/block/by-name/misc             flags=display="misc";backup=1;flashimg=1
/boot_para	    emmc	/dev/block/by-name/boot_para        flags=display="boot_para";backup=1
/proinfo	    emmc	/dev/block/by-name/proinfo          flags=display="Proinfo";backup=1;flashimg=1

# Non-Volatile (RAM | DATA | CFG)
/nvcfg		    ext4	/dev/block/by-name/nvcfg            flags=display="NvCfg";backup=1
/nvdata		    ext4	/dev/block/by-name/nvdata           flags=display="NvData";backup=1
/nvram		    emmc	/dev/block/by-name/nvram            flags=display="NvRam";backup=1;flashimg=1

# Subscriber Identification Module (SIM)
/protect_f	    ext4	/dev/block/by-name/protect1         flags=display="Protect";backup=1;flashimg=1
/protect_s	    ext4	/dev/block/by-name/protect2         flags=backup=1;subpartitionof=/protect_f

# Trusted Execution Environment (TEE) - trustzone
/tee1		    emmc	/dev/block/by-name/tee1             flags=display="Tee1";backup=1;flashimg=1
/tee2		    emmc	/dev/block/by-name/tee2             flags=display="Tee2";backup=1;flashimg=1

# Factory Reset Protection (FRP)
/persistent	    emmc	/dev/block/by-name/frp              flags=display="frp";backup=1;flashimg=1

# Firmware
/gz1            emmc    /dev/block/by-name/gz1               flags=display="gz1";backup=1
/gz2            emmc    /dev/block/by-name/gz2               flags=display="gz2";backup=1

# Modem
/md1img		    emmc	/dev/block/by-name/md1img           flags=display="Modem";backup=1;flashimg=1
/md1dsp         emmc    /dev/block/by-name/md1dsp            flags=display="md1dsp";backup=1

# System Control Processor (SCP)
/scp1		    emmc	/dev/block/by-name/scp1             flags=display="scp1";backup=1
/scp2		    emmc	/dev/block/by-name/scp2             flags=display="scp2";backup=1

#Mod lopestom about encrypt_decrypt data
/oemkeystore		emmc	/dev/block/by-name/oemkeystore
/keystore		emmc	/dev/block/by-name/keystore

# Other partitions
/otp            emmc    /dev/block/by-name/otp               flags=display="otp";backup=1
/spmfw		    emmc	/dev/block/by-name/spmfw            flags=display="Spm";backup=1
/sspm_1		    emmc	/dev/block/by-name/sspm_1           flags=display="sspm_1";backup=1
/sspm_2		    emmc	/dev/block/by-name/sspm_2           flags=display="sspm_2";backup=1
#/odmdtbo emmc /dev/block/by-name/odmdtbo

# External-Devices (SDCARD | OTG)
/external_sd    auto     /dev/block/mmcblk1p1  /dev/block/mmcblk1    flags=display="External_SDcard";storage;wipeingui;removable;fsflags="utf8"
/usb_otg        auto     /dev/block/sda1      /dev/block/sda         flags=display="Usb_Otg";storage;wipeingui;removable;fsflags="utf8"
